# .env.example - Sensitive Configuration Only
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================================================
# AUTHENTICATION (Choose ONE method)
# ============================================================================

# Method 1 (RECOMMENDED for production): Use encrypted keystore
# Create keystore: cast wallet import deployer --interactive
# Then use: forge script --account deployer --sender <address>
# No PRIVATE_KEY needed when using keystore

# Method 2 (NOT RECOMMENDED for production): Private key
# Only use for testing/development
# PRIVATE_KEY=0x...

# ============================================================================
# RPC ENDPOINTS
# ============================================================================

# Generic RPC URL - set this to the target chain's RPC endpoint
RPC_URL=https://rpc.soniclabs.com

# Chain-specific RPC URLs (used by foundry.toml rpc_endpoints)
SONIC_RPC_URL=https://rpc.soniclabs.com
SONIC_TESTNET_RPC_URL=https://rpc.testnet.soniclabs.com

# For local testing
# ANVIL_RPC_URL=http://127.0.0.1:8545

# ============================================================================
# BLOCK EXPLORER API KEYS
# ============================================================================

# ETHERSCAN API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================================================
# NOTES
# ============================================================================
# All non-sensitive configuration (addresses, roles, caps, etc.) is now in:
# script/config/deployments.toml
#
# Edit that file to configure deployment parameters per network.
